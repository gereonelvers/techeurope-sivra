# ── Quartermaster environment ────────────────────────────────────────────────
# Copy to .env and fill in. Every external API is isolated behind one client
# module, so a missing key only disables that one feature — nothing else breaks.

# Pioneer (Fastino) — delegation router fine-tune.  https://gliner.pioneer.ai
PIONEER_API_KEY=
PIONEER_BASE_URL=https://api.pioneer.ai/v1
PIONEER_ROUTER_MODEL=                 # set to the trained model/job id once fine-tuned

# WhatsApp via Twilio — delivery tiers a/b (text + tappable replies).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio sandbox sender
# Voice tier (tier c): a real phone call bridged to Gemini Live (Pipecat/Twilio).
TWILIO_PHONE_FROM=                    # a Twilio voice number, e.g. +1502...

# Google / Gemini — Gemini Live (voice tier) + Gemini as a frontier eval contender.
GEMINI_API_KEY=

# Frontier eval contender.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=                  # optional 3rd contender

# HuggingFace — pull gated Gemma 4 weights (accept the license on HF first).
HUGGINGFACE_API_KEY=

# Modal — GPU fine-tune + serving + browser sandboxes.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Railway — managed Postgres + deployment.
RAILWAY_API_KEY=
DATABASE_URL=                         # Railway Postgres URL (or sqlite file for local dev)

# Supervisor service URL (used by the buyer agents to escalate).
SUPERVISOR_URL=http://localhost:8000
