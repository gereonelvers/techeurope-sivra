# ── sivra environment ────────────────────────────────────────────────
# Copy to .env and fill in. Every external API is isolated behind one client
# module, so a missing key only disables that one feature — nothing else breaks.

# Pioneer (Fastino) — delegation router fine-tune.  https://gliner.pioneer.ai
PIONEER_API_KEY=
PIONEER_BASE_URL=https://api.pioneer.ai/v1
PIONEER_ROUTER_MODEL=                 # set to the trained model/job id once fine-tuned

# Telnyx — SMS delivery (tiers a/b) + Voice (tier c: Call Control + WebSocket
# media streaming bridged to Gemini Live). SMS to a plain mobile needs no opt-in.
TELNYX_API_KEY=
TELNYX_FROM=                          # your Telnyx number, E.164 e.g. +4915...
TELNYX_MESSAGING_PROFILE_ID=          # required when using an alpha sender
TELNYX_ALPHA_SENDER=                  # alphanumeric sender (≤11 chars) for intl A2P, e.g. QMaster
TELNYX_VOICE_CONNECTION_ID=           # Call Control app id, for the voice tier
# Voice service URL — set ONLY on the deployed supervisor so urgency=voice places a
# real call (kept out of local .env so test runs never dial). e.g. https://voice-...up.railway.app
VOICE_URL=
# Demo recipient(s) — keeps personal numbers out of git. SIVRA_DEMO_PHONE routes all
# roles to one phone; or set SIVRA_PHONE_BUYER / SIVRA_PHONE_PROCUREMENT_LEAD / SIVRA_PHONE_MANAGER.
SIVRA_DEMO_PHONE=

# Google / Gemini — Gemini Live (voice tier) + Gemini as a frontier eval contender.
GEMINI_API_KEY=

# Frontier eval contender.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=                  # optional 3rd contender

# HuggingFace — pull gated Gemma 4 weights (accept the license on HF first).
HUGGINGFACE_API_KEY=

# Modal — GPU fine-tune + serving + browser sandboxes.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Railway — managed Postgres + deployment.
RAILWAY_API_KEY=
DATABASE_URL=                         # Railway Postgres URL (or sqlite file for local dev)

# Supervisor service URL (fallback escalation path: the buyer agents POST
# {SUPERVISOR_URL}/escalate and poll /resolution/{id}). Used ONLY when
# APP_INTERNAL_URL is unset (back-compat with today's live demo flow).
SUPERVISOR_URL=http://localhost:8000
# App internal API base (the new sivra.io app). When SET, the fleet routes
# escalations to {APP_INTERNAL_URL}/api/internal/escalations and posts audit
# OrderEvents + receipts to {APP_INTERNAL_URL}/api/internal/orders/{id}/{event,result}.
# When UNSET, the fleet keeps the supervisor /escalate fallback and skips audit.
# e.g. https://sivra.io  (or the Railway web URL)
APP_INTERNAL_URL=
# Shared secret for /api/internal/* + /api/voice/* (header x-internal-token).
INTERNAL_API_TOKEN=
# Public base for SMS reply links (set to the deployed domain, e.g. https://sivra.io).
PUBLIC_BASE_URL=

# Cloudflare (DNS for sivra.io) + Railway (hosting).
CLOUDFLARE_API_KEY=
RAILWAY_API_KEY=
